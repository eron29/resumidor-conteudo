# Copie este arquivo para .streamlit/secrets.toml e preencha com sua chave real.
# NUNCA versione o arquivo secrets.toml (ele já está no .gitignore).
OPENAI_API_KEY = "sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Opcional: só necessário se o YouTube bloquear as requisições vindas do servidor
# (comum em hospedagens na nuvem, como o Streamlit Community Cloud). Crie uma conta
# gratuita em https://www.webshare.io/, gere credenciais de "Proxy" e cole abaixo.
# WEBSHARE_PROXY_USERNAME = "xxxxxxxx"
# WEBSHARE_PROXY_PASSWORD = "xxxxxxxx"
